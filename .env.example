# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า ห้าม commit ไฟล์ .env

# --- Docker Compose (ฐานข้อมูล PostgreSQL ในเครื่อง สำหรับ Back-office PHP) ---
# ตั้งรหัสอะไรก็ได้ ใช้ภายใน Docker ของเครื่องตัวเองเท่านั้น
LOCAL_DB_PASSWORD=choose-a-local-password

# --- (ไม่บังคับ) ถ้าใช้ PostgreSQL บน Supabase ของตัวเอง สำหรับ FastAPI ---
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_NAME=postgres
